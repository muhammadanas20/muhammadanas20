# Copy this file to .env and fill in values.
# NEVER commit .env. NEVER paste keys into chat, issues, or notebooks.

# --- LLM providers (use at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Local models via Ollama need no key.
# OLLAMA_HOST=http://localhost:11434

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-engineer-roadmap

# --- Vector databases ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai_engineer
REDIS_URL=redis://localhost:6379/0

# --- Rate limits / cost caps ---
MAX_TOKENS_PER_REQUEST=4096
DAILY_TOKEN_BUDGET=500000
